# ============================================================
#  NEX-SCOPE - Variables de entorno
# ============================================================
# Copia este archivo a `.env.local` y completa los valores.
# El archivo `.env.local` NO se sube a GitHub (esta en .gitignore).

# URL publica de la app (cambiala si desplegas en produccion)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base de datos SQLite local (no tocar)
DATABASE_URL=file:./db/custom.db

# JWT para sesiones de usuario
# Genera uno aleatorio de 32+ caracteres. Ej: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-aleatoria-larga-y-secreta-1234567890
JWT_EXPIRES_IN=7d

# YouTube Data API v3
# Como obtenerla:
#   1. Entrá a https://console.cloud.google.com/
#   2. Creá un proyecto (o usá uno existente)
#   3. Habilitá "YouTube Data API v3"
#   4. Andá a Credenciales -> Crear credenciales -> Clave de API
#   5. Copiá la clave acá
YOUTUBE_API_KEY=

# ============================================================
#  CAZADOR mesh webhook secret (CAZADOR <-> NEX-SCOPE fusion)
# ============================================================
# Secreto HMAC-SHA256 compartido entre la extensión CAZADOR y NEX-SCOPE.
# CAZADOR firma cada POST a /api/mesh/external-signals con
#   `X-Cazador-Signature: sha256=HMAC_SHA256(rawBody, <secret>)`
# y NEX-SCOPE lo verifica en constante tiempo antes de persistir la señal.
#
# Genera uno aleatorio de 32+ caracteres:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# El mismo valor DEBE configurarse en la extensión CAZADOR (panel de
# ajustes del sidebar → "CAZADOR_WEBHOOK_SECRET"). Si no se setea:
#   - En dev: la ruta /api/mesh/external-signals acepta todo (modo abierto,
#     con un warning por request en el log).
#   - En prod: RECOMENDADO setearlo — sin él, cualquier usuario autenticado
#     puede pushear señales arbitrarias bajo cualquier `source`.
CAZADOR_WEBHOOK_SECRET=
