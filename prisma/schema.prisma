generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Schema notes (audit-3)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// - Every multi-tenant table now has a relation back to User with
//   `onDelete: Cascade`, so deleting a User also wipes their saved niches,
//   channels, chat history and plans. The foreign key stays nullable so
//   legacy rows (created before auth was enforced) are preserved.
// - Added `@@index([userId])` to every multi-tenant table — every list
//   query is filtered by `userId`, the index turns those queries from a
//   full table scan into an index lookup.
// - Added composite `@@index([userId, nicheId])` and `@@index([userId, channelId])`
//   to back the upsert / findFirst lookups in saved-niches / saved-channels.
// - Added `updatedAt` to ChatMessage for consistency with the rest of the
//   models and to surface "last edit" semantics in future UI.
// - Added `@@index([userId, createdAt])` to ChatMessage and ContentPlan to
//   back the `findMany({ orderBy: { createdAt } })` queries.
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String?
  password         String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  savedNiches      SavedNiche[]
  savedChannels    SavedChannel[]
  chatMessages     ChatMessage[]
  contentPlans     ContentPlan[]
  memories         Memory[]
  executionTraces  ExecutionTrace[]
}

model SavedNiche {
  id         String   @id @default(cuid())
  nicheId    String
  nicheName  String
  category   String
  nicheScore Float
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([userId, nicheId])
}

model SavedChannel {
  id          String   @id @default(cuid())
  channelId   String
  channelName String
  subscribers Int
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([userId, channelId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String
  content   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  // @default(now()) backfills existing rows when the column is added; @updatedAt
  // triggers an automatic refresh on subsequent writes.
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
}

model ContentPlan {
  id        String   @id @default(cuid())
  niche     String
  audience  String
  planData  String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Memory — agent memory store
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Stores episodic / semantic / factual / procedural memories generated
// by the agent tools. Relevance decays over time; duplicate memories are
// marked as `deprecated` by the consolidation routine. Truth level is
// always ESTIMATED for AI-generated memories and can be bumped to VERIFIED
// by explicit user input.
model Memory {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain        String   // "youtube_intelligence"
  type          String   // EPISODIC | SEMANTIC | FACTUAL | PROCEDURAL
  content       String   // contenido de la memoria (texto o JSON string)
  source        String   // qué herramienta/dato la generó
  evidence      String?  // JSON opcional con evidencia
  provenance    String   // AI_MODEL | YOUTUBE_API | USER_INPUT | CONSOLIDATED
  confidence    Float    @default(0.5) // 0..1
  truthLevel    String   @default("ESTIMATED") // OBSERVED|VERIFIED|ESTIMATED|MODELED|INFERRED|UNKNOWN
  scope         String   @default("user") // user|global
  status        String   @default("active") // active|deprecated|retired
  relevance     Float    @default(0.5) // 0..1, decae con el tiempo
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastVerified  DateTime @default(now())

  @@index([userId])
  @@index([userId, domain])
  @@index([userId, type])
  @@index([userId, status])
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ExecutionTrace — per-agent-run audit log
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// One row per agent invocation. Captures the task, the ordered list of
// tool calls with their ok/err status, and the final outputs / errors.
// Useful for debugging, replay and observability of the agent loop.
model ExecutionTrace {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId     String   @default("nexscope-agent")
  task        String   // mensaje del usuario o descripción
  tools       String   // JSON array de tool calls ejecutados
  inputs      String?  // JSON
  outputs     String?  // JSON
  errors      String?  // JSON
  status      String   @default("running") // running|completed|error|aborted
  startTime   DateTime @default(now())
  endTime     DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([userId, status])
  @@index([userId, createdAt])
}
